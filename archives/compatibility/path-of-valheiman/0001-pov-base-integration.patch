@@ -0,0 +1,106 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Runtime.CompilerServices;
+using ItemData = InventorySlots.ItemDrop.ItemData;
+namespace InventorySlots;
+public class Transform {
+    public Transform? Parent;
+    public bool IsChildOf(Transform parent) => Parent == parent;
+}
+public class GameObject { public bool activeSelf = true; public Transform transform = new(); }
+public class UITooltip {
+    public static UITooltip? m_current;
+    public static GameObject? m_tooltip;
+    public bool IsItem = true;
+}
+public class ItemDrop { public class ItemData {
+    public object? m_shared = new(); public bool m_equipped; public bool Favorite; public Vector2i m_gridPos;
+} }
+public record struct Vector2i(int x, int y);
+public enum InventoryCellKind { Hotbar, RegularUnlocked, RegularLocked, Quick, Equipment }
+public class Inventory {
+    public List<ItemData> m_inventory = new();
+    public List<ItemData> GetAllItems() => m_inventory;
+    public bool ContainsItem(ItemData item) => m_inventory.Contains(item);
+    public void Changed() { }
+}
+public class Humanoid { public Inventory Inventory = new(); public Inventory GetInventory() => Inventory; }
+public class Player : Humanoid { public static Player? m_localPlayer; public bool m_isLoading; }
+public class InventoryGui {
+    public static InventoryGui? instance = new();
+    public void SetupDragItem(object? a, object? b, int c) { }
+}
+public static class InventoryActionCellPolicyCore { public static bool CanFavoriteSlot(InventoryCellKind k) => true; }
+public static class Log { public static void LogWarning(string s) { } }
+public sealed partial class InventorySlotsPlugin {
+/* PRODUCTION */
+private static UITooltip? _inventoryContainerHoverTooltipSource, _inventorySlotsOwnedHoverTooltipSource;
+private static int hidden, restored, refreshes;
+private static bool IsUnityNull(object? o) => o == null;
+private static bool ContainerAreaPlayerLoading(Player p) => p.m_isLoading;
+private static bool IsInventoryContainerTooltipSource(UITooltip t) => t.IsItem;
+private static void HideInventoryContainerCustomTooltip() => hidden++;
+private static void ForceHideInventorySimpleNameTooltip() { }
+private static void RestoreVanillaTooltipVisual(GameObject? o) => restored++;
+private static void PruneInventoryHoverTooltipSources() { }
+private static InventoryCellKind GetInventoryCellKind(Player p, Inventory inv, Vector2i pos) =>
+    pos.y == 0 ? InventoryCellKind.Hotbar : pos.y < 4 ? InventoryCellKind.RegularUnlocked : pos.y < 9 ? InventoryCellKind.RegularLocked : pos.y == 9 ? InventoryCellKind.Quick : InventoryCellKind.Equipment;
+private static bool IsFavoriteProtected(Player p, Inventory inv, ItemData item) => item.Favorite;
+private static List<Vector2i> GetPlayerActionSlots(Player p, Inventory inv, bool includeHotbar, bool blockFavorites) =>
+    Enumerable.Range(0, 8).Select(x => new Vector2i(x, 1)).Where(cell => !inv.m_inventory.Any(i => i.m_gridPos == cell && i.Favorite)).ToList();
+private static List<Vector2i> destinations = new();
+private static List<ItemData> sources = new();
+private static bool FillFavoriteStacks(Inventory inv, List<ItemData> targets, List<ItemData> source) {
+    if (source.Any(i => i.m_equipped)) throw new Exception("equipped item consumed as favorite source"); return false;
+}
+private static int SortInventoryInternal(Inventory inv, List<Vector2i> cells, Func<ItemData,bool> predicate) {
+    destinations = cells; sources = inv.m_inventory.Where(predicate).ToList(); return 0;
+}
+private static void Verify(bool value, string label) { if (!value) throw new Exception(label); }
+public static void Check() {
+    var player = Player.m_localPlayer = new Player();
+    var normal = new ItemData { m_gridPos = new(1,1) };
+    var equipped = new ItemData { m_gridPos = new(2,1), m_equipped = true };
+    var favorite = new ItemData { m_gridPos = new(3,1), Favorite = true };
+    var items = player.Inventory.m_inventory;
+    items.AddRange(new[] { normal, equipped, favorite, new ItemData {m_gridPos = new(0,0)}, new ItemData {m_gridPos = new(0,4)}, new ItemData {m_gridPos = new(0,9)}, new ItemData {m_gridPos = new(0,10)} });
+    var movable = new List<ItemData>(items) { new ItemData {m_gridPos = new(7,1)} };
+    FilterPathOfValheimanMovableItems(player, movable);
+    Verify(movable.SequenceEqual(new[] { normal }), "movable retains only present, unprotected regular items");
+    Verify(!SortPathOfValheimanInventory(player), "PoV direct sort suppressed");
+    Verify(!sources.Contains(equipped) && !destinations.Contains(equipped.m_gridPos), "equipped source AND destination preserved");
+    Verify(!sources.Contains(favorite) && !destinations.Contains(favorite.m_gridPos), "favorite source AND destination preserved");
+    Verify(sources.SequenceEqual(new[] { normal }), "sort excludes tail, hotbar and locked cells");
+    InventoryGui.instance = null; sources.Clear();
+    Verify(!SortPathOfValheimanInventory(player) && sources.Count == 0, "missing GUI does not invoke unsafe sort");
+
+    var tooltip = UITooltip.m_current = new UITooltip();
+    var root = UITooltip.m_tooltip = new GameObject { activeSelf = false }; // Native hover delay.
+    var body = new GameObject(); body.transform.Parent = root.transform;
+    Verify(!TryYieldToPathOfValheimanTooltip(tooltip), "PoV absent retains Slots tooltip");
+    bool wanted = true;
+    _pathOfValheimanTooltipWanted = () => wanted;
+    _pathOfValheimanTooltipOwners = new(); _pathOfValheimanTooltipOwners.Add(tooltip, normal);
+    _pathOfValheimanCurrentTooltip = () => UITooltip.m_current!;
+    _pathOfValheimanTooltipRoot = () => UITooltip.m_tooltip!;
+    _pathOfValheimanTooltipBody = () => body;
+    _pathOfValheimanRefreshTooltip = () => refreshes++;
+    Verify(TryYieldToPathOfValheimanTooltip(tooltip) && refreshes == 0, "existing PoV card owns even delayed native root without rebuild");
+    OnVanillaTooltipHidden(); // PoV suppressed original Hide while Alt held.
+    Verify(TryYieldToPathOfValheimanTooltip(tooltip) && refreshes == 0, "Alt pinned Hide cancellation preserves handlers");
+    wanted = false; Verify(!TryYieldToPathOfValheimanTooltip(tooltip), "live Off returns Slots ownership");
+    wanted = true; Verify(TryYieldToPathOfValheimanTooltip(tooltip) && refreshes == 1, "live On refreshes once");
+    TryYieldToPathOfValheimanTooltip(tooltip); Verify(refreshes == 1, "steady hover does not rebuild");
+    tooltip.IsItem = false; Verify(!TryYieldToPathOfValheimanTooltip(tooltip), "noninventory source not claimed");
+    tooltip.IsItem = true; body.transform.Parent = new Transform();
+    Verify(!TryYieldToPathOfValheimanTooltip(tooltip), "failed/misparented PoV rendering keeps text fallback");
+    _pathOfValheimanTooltipWanted = () => throw new Exception("external callback");
+    Verify(!TryYieldToPathOfValheimanTooltip(tooltip), "callback error keeps fallback");
+    UITooltip.m_current = null; UITooltip.m_tooltip = null; OnVanillaTooltipHidden();
+    Verify(_pathOfValheimanTooltipSource == null, "real hide clears references");
+    _pathOfValheimanTreeOpen = () => true; Verify(IsPathOfValheimanTreeOpen(), "open tree gates guide");
+    _pathOfValheimanTreeOpen = () => throw new Exception("tree getter");
+    Verify(!IsPathOfValheimanTreeOpen() && _pathOfValheimanTreeOpen == null, "failed external tree getter disabled once");
+}
+}
