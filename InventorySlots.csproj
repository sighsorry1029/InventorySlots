    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <Target Name="GetAssemblyVersion" AfterTargets="$(AfterTargets)">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="Targets"/>
        </GetAssemblyIdentity>
        <ItemGroup>
            <AssemblyVersions Include="@(Targets->'%(Version)')"/>
        </ItemGroup>
        <Error Text="Failed to get Assembly Version." Condition="'%(AssemblyVersions.Identity)' == ''"/>
        <PropertyGroup>
            <AssemblyVersion>%(AssemblyVersions.Identity)</AssemblyVersion>
            <Major>$(AssemblyVersion.Split('.')[0])</Major>
            <Minor>$(AssemblyVersion.Split('.')[1])</Minor>
            <Patch>$(AssemblyVersion.Split('.')[2])</Patch>
            <PackageName>$(AssemblyName)_v$(Major).$(Minor).$(Patch)</PackageName>
            <PackageVersion>$(Major).$(Minor).$(Patch)</PackageVersion>
            <PackageDir>$(ProjectDir)\Thunderstore\$(PackageName)</PackageDir>
            <ThunderstoreZip>$(ProjectDir)\Thunderstore\$(PackageName).zip</ThunderstoreZip>
            <NexusPackageDir>$(ProjectDir)\Nexus\$(PackageName)</NexusPackageDir>
            <NexusZip>$(ProjectDir)\Nexus\$(PackageName).zip</NexusZip>
        </PropertyGroup>
    </Target>
    <Target Name="PackageRelease" AfterTargets="GetAssemblyVersion" Condition="'$(Configuration)' == 'Release'">
        <Delete Files="$(ProjectDir)\Thunderstore\README.md" Condition="Exists('$(ProjectDir)\Thunderstore\README.md')"/>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference = 'Stop'; $p = '$(ProjectDir)\Thunderstore\manifest.json'; $text = Get-Content -Raw -LiteralPath $p; $updated = [regex]::Replace($text, '(\x22version_number\x22\s*:\s*\x22)[^\x22]+(\x22)', '${1}$(PackageVersion)${2}'); if ($updated -ne $text) { $enc = New-Object System.Text.UTF8Encoding $false; [System.IO.File]::WriteAllText($p, $updated, $enc) }&quot;"/>

        <RemoveDir Directories="$(PackageDir)" Condition="Exists('$(PackageDir)')"/>
        <MakeDir Directories="$(PackageDir)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PackageDir)\$(AssemblyName).dll"/>
        <Copy SourceFiles="$(ProjectDir)\README.md" DestinationFiles="$(PackageDir)\README.md"/>
        <Copy SourceFiles="$(ProjectDir)\Thunderstore\CHANGELOG.md" DestinationFiles="$(PackageDir)\CHANGELOG.md"/>
        <Copy SourceFiles="$(ProjectDir)\Thunderstore\manifest.json" DestinationFiles="$(PackageDir)\manifest.json"/>
        <Copy SourceFiles="$(ProjectDir)\Thunderstore\icon.png" DestinationFiles="$(PackageDir)\icon.png"/>
        <Copy SourceFiles="$(ProjectDir)\translations\English.yml" DestinationFiles="$(PackageDir)\$(AssemblyName).English.yml"/>
        <Delete Files="$(ThunderstoreZip)" Condition="Exists('$(ThunderstoreZip)')"/>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(PackageDir)\*' -DestinationPath '$(ThunderstoreZip)' -Force&quot;"/>
        <RemoveDir Directories="$(PackageDir)" Condition="Exists('$(PackageDir)')"/>

        <RemoveDir Directories="$(NexusPackageDir)" Condition="Exists('$(NexusPackageDir)')"/>
        <MakeDir Directories="$(NexusPackageDir)" Condition="Exists('$(ProjectDir)\Nexus')"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(NexusPackageDir)\$(AssemblyName).dll" Condition="Exists('$(ProjectDir)\Nexus')"/>
        <Delete Files="$(NexusZip)" Condition="Exists('$(NexusZip)')"/>
        <Exec Condition="Exists('$(ProjectDir)\Nexus')" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(NexusPackageDir)\*' -DestinationPath '$(NexusZip)' -Force&quot;"/>
        <RemoveDir Directories="$(NexusPackageDir)" Condition="Exists('$(NexusPackageDir)')"/>
    </Target>
    <Target Name="CopyOutputDLL" AfterTargets="GetAssemblyVersion">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyOutputDLLPath)" Condition="'$(CopyOutputDLLPath)' != '' AND Exists('$(CopyOutputDLLPath)')"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyOutputDLLPath2)" Condition="'$(CopyOutputDLLPath2)' != '' AND Exists('$(CopyOutputDLLPath2)')"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyOutputDLLPath3)" Condition="'$(CopyOutputDLLPath3)' != '' AND Exists('$(CopyOutputDLLPath3)')"/>
    </Target>
