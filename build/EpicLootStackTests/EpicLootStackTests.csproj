<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StackTarget Condition="'$(StackTarget)' == ''">InventoryActions</StackTarget>
    <DefineConstants Condition="'$(StackTarget)' == 'InventorySlots'">$(DefineConstants);INVENTORY_SLOTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/Sorting/EpicLootStacking.cs" Link="EpicLootStacking.cs" />
    <Compile Include="../../Shared/Sorting/FavoriteStackFill.cs" Link="FavoriteStackFill.cs" />
    <Compile Include="../../StackMetadataPolicy.cs" Link="StackMetadataPolicy.cs" Condition="'$(StackTarget)' == 'InventorySlots'" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
