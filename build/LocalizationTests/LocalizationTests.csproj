<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LocalizationTarget Condition="'$(LocalizationTarget)' == ''">InventoryActions</LocalizationTarget>
    <DefineConstants Condition="'$(LocalizationTarget)' == 'InventorySlots'">$(DefineConstants);INVENTORY_SLOTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/ItemRules/UiLocalization.cs" Link="UiLocalization.cs" />
  </ItemGroup>
</Project>
