<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LocalizationTarget Condition="'$(LocalizationTarget)' == ''">InventoryActions</LocalizationTarget>
    <DefineConstants Condition="'$(LocalizationTarget)' == 'InventorySlots'">$(DefineConstants);INVENTORY_SLOTS</DefineConstants>
    <LocalizationRoot Condition="'$(LocalizationTarget)' == 'InventorySlots'">../..</LocalizationRoot>
    <LocalizationRoot Condition="'$(LocalizationTarget)' == 'InventoryActions'">../../InventoryActions</LocalizationRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LocalizationRoot)/LocalizationManager/Localizer.cs" Link="Localizer.cs" />
    <Compile Include="../../Shared/ItemRules/UiLocalization.cs" Link="UiLocalization.cs" />
    <EmbeddedResource Include="$(LocalizationRoot)/translations/English.yml" LogicalName="translations.English.yml" />
    <EmbeddedResource Include="$(LocalizationRoot)/translations/Korean.yml" LogicalName="translations.Korean.yml" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
