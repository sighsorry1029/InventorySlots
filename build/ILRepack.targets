<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Target Name="ILRepacker" AfterTargets="Build">
        <ItemGroup>
            <InputAssemblies Include="$(TargetPath)" />
            <InputAssemblies Include="$(OutputPath)Libs\ServerSync.dll" Condition="Exists('$(OutputPath)Libs\ServerSync.dll')" />
            <InputAssemblies Include="$(OutputPath)YamlDotNet.dll" Condition="Exists('$(OutputPath)YamlDotNet.dll')" />
        </ItemGroup>
        <ILRepack Parallel="true" DebugInfo="$(DebugSymbols)" Internalize="true" InputAssemblies="@(InputAssemblies)" OutputFile="$(TargetPath)" TargetKind="SameAsPrimaryAssembly" LibraryPath="$(OutputPath)" />
    </Target>
</Project>
