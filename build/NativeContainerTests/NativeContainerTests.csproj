<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NativeTarget Condition="'$(NativeTarget)' == ''">InventoryActions</NativeTarget>
    <DefineConstants Condition="'$(NativeTarget)' == 'InventorySlots'">$(DefineConstants);INVENTORY_SLOTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/ItemRules/NativeContainerHandoff.cs" Link="NativeContainerHandoff.cs" />
  </ItemGroup>
</Project>
